{
  "version": 2,
  "builds": [
    {
      "src": "api/room/playlist.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/search/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/mood/categories.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/mood/playlists.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/rooms/(?<room_id>[^/]+)/playlist",
      "dest": "/api/room/playlist.py",
      "methods": ["GET", "POST", "DELETE", "PUT", "OPTIONS"]
    },
    {
      "src": "/api/search",
      "dest": "/api/search/index.py",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/get-mood-categories",
      "dest": "/api/mood/categories.py",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/get-mood-playlists",
      "dest": "/api/mood/playlists.py",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/get-playlist",
      "dest": "/api/room/playlist.py",
      "methods": ["GET", "OPTIONS"]
    }
  ]
}
