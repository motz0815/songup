{
    "name": "@songup/backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "exports": {
        "./convex/_generated/api": {
            "types": "./convex/_generated/api.d.ts",
            "default": "./convex/_generated/api.js"
        },
        "./convex/_generated/dataModel": {
            "types": "./convex/_generated/dataModel.d.ts",
            "default": "./convex/_generated/dataModel.d.ts"
        },
        "./convex/*": "./convex/*"
    },
    "scripts": {
        "dev": "convex dev",
        "deploy": "convex deploy",
        "lint": "eslint .",
        "check-types": "tsc --noEmit -p convex/tsconfig.json"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "eslint": "^9.39.4",
        "eslint-config-next": "16.4.3",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@auth/core": "0.37.0",
        "@convex-dev/auth": "^0.0.96",
        "@convex-dev/crons": "^0.2.3",
        "@convex-dev/stripe": "^0.1.7",
        "@erquhart/convex-oss-stats": "^0.8.2",
        "convex": "^1.48.0",
        "convex-helpers": "^0.1.129",
        "posthog-node": "^5.57.1",
        "stripe": "^20.5.0-alpha.4"
    }
}
