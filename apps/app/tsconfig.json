{
  "extends": "@songup/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/convex/*": ["../../packages/backend/convex/*"],
      "@/components/ui/*": ["../../packages/ui/src/components/*"],
      "@/lib/utils": ["../../packages/ui/src/lib/utils"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
