{
    "name": "@songup/web",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "next-dev": "next dev --turbopack --port 3000",
        "flask-dev": "FLASK_DEBUG=1 pip3 install --break-system-packages -r requirements.txt && python3 -m flask --app api/flask/index run -p 5328",
        "dev": "concurrently \"bun run next-dev\" \"bun run flask-dev\"",
        "build": "next build",
        "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then cd ../../packages/backend && bunx convex deploy --cmd 'cd ../../apps/web && bun run build'; else bun run build; fi",
        "start": "next start --port 3000",
        "lint": "eslint .",
        "check-types": "tsc --noEmit"
    },
    "dependencies": {
        "@convex-dev/auth": "^0.0.96",
        "@formkit/auto-animate": "^0.10.0",
        "@paper-design/shaders-react": "^0.0.82",
        "@songup/backend": "workspace:*",
        "@songup/ui": "workspace:*",
        "convex": "^1.48.0",
        "date-fns": "^4.4.0",
        "lucide-react": "^1.61.0",
        "next": "16.4.3",
        "posthog-js": "^1.438.21",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-icons": "^5.7.0",
        "react-qr-code": "^2.2.0",
        "react-youtube": "^10.1.0",
        "sonner": "^2.0.8"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^22.20.5",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "concurrently": "^10.0.6",
        "eslint": "^9.39.4",
        "eslint-config-next": "16.4.3",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3"
    }
}
