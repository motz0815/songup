# SongUp monorepo — environment variables per Vercel application.
# Copy the vars a zone needs into that Vercel project's Environment Variables,
# or into apps/<zone>/.env.local for local development.
#
# ─────────────────────────────────────────────────────────────────────────────
# apps/web  (PRIMARY zone — website + product routes, owns songup.tv)
# ─────────────────────────────────────────────────────────────────────────────
# Multi-zone rewrite targets. In local development these default to the Docs
# server on localhost:3001 and the Blog server on localhost:3002.
DOCS_DOMAIN=https://docs.songup.tv
BLOG_DOMAIN=https://blog.songup.tv
# Product, authentication, analytics, and payment client configuration.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_STRIPE_ROOM_PRICE=price_xxx
NEXT_PUBLIC_SITE_URL=https://songup.tv
# Required for the production `vercel-build`, which deploys Convex before the
# web application is built:
CONVEX_DEPLOY_KEY=prod:your-deploy-key
# Note: Stripe secret keys, PostHog server keys, and auth secrets live in the
# Convex deployment's environment (Convex dashboard), NOT in Vercel.

# ─────────────────────────────────────────────────────────────────────────────
# apps/blog  (SECONDARY zone — /blog)  — optional
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://songup.tv

# ─────────────────────────────────────────────────────────────────────────────
# apps/docs  (SECONDARY zone — /docs)  — no environment variables required
# ─────────────────────────────────────────────────────────────────────────────
